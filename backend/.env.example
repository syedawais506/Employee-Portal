# Application
APP_NAME="Employee Portal"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
API_V1_PREFIX=/api/v1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=employee_portal
DATABASE_URL=postgresql+psycopg://portal:portal@localhost:5432/employee_portal

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_ME_EXPIRE_DAYS=30

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@employee-portal.local
SMTP_FROM_NAME=
SMTP_USE_TLS=false

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
# Leave blank to fall back to S3_ENDPOINT_URL above (correct for this
# non-Docker local setup, where MinIO is already reachable at that same
# localhost address from both the backend and your browser). Only needs to
# differ when the backend and the browser reach MinIO by different
# hostnames — e.g. the Docker Compose setup, where the backend uses the
# internal "http://minio:9000" but presigned download URLs must be signed
# against "http://localhost:9000" for the browser to resolve them.
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=employee-portal
S3_REGION=us-east-1

# Frontend URL (for password reset / email links)
FRONTEND_BASE_URL=http://localhost:5173

# Rate limiting
AUTH_RATE_LIMIT=5/minute
