# Copied to docker/.env by scripts/dev-up.sh (or manually) — consumed by docker-compose.yml.
# scripts/dev-up.sh replaces every CHANGE-ME placeholder below with a real
# generated value automatically on first run.

# development (default here, for local Docker Compose testing) keeps /docs
# and /openapi.json reachable and skips the HSTS header. Set to "production"
# for a real deployment — docker-compose.yml falls back to "production" on
# its own if this var is entirely unset, so a real deploy that doesn't reuse
# this file is secure by default either way.
APP_ENV=development

POSTGRES_USER=portal
# Generate real values for every CHANGE-ME below before running this anywhere
# reachable by anyone but you — e.g. `openssl rand -base64 32`. These are not
# usable as-is; docker-compose.yml refuses to start without them set.
POSTGRES_PASSWORD=CHANGE-ME-generate-with-openssl-rand-base64-32
POSTGRES_DB=employee_portal

SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-base64-32
CORS_ORIGINS=http://localhost:8080

# Restricted, non-superuser DB role the app connects as at runtime, so Row-
# Level Security policies actually apply (POSTGRES_USER above is always a
# superuser, which unconditionally bypasses RLS — see
# docker/postgres-initdb/01-create-app-role.sh). Only takes effect on a
# brand-new postgres_data volume; migrations still use POSTGRES_USER.
APP_DB_USER=app_runtime
APP_DB_PASSWORD=CHANGE-ME-generate-with-openssl-rand-base64-32

# Default (mailhog) only captures email locally at http://localhost:8025 —
# it never reaches a real inbox. To send real email, point these at a real
# provider's SMTP relay (see README.md "Sending real email"), e.g. AWS SES:
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER=<SES SMTP username, not your AWS access key>
#   SMTP_PASSWORD=<SES SMTP password, not your AWS secret key>
#   SMTP_USE_TLS=true
#   SMTP_FROM_EMAIL=<a verified SES sender address>
#   SMTP_FROM_NAME=Employee Portal
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=no-reply@employee-portal.local
SMTP_FROM_NAME=

S3_ENDPOINT_URL=http://minio:9000
# The backend reaches MinIO via the internal Docker hostname above, but
# presigned download URLs are opened by the *browser*, which can't resolve
# "minio" — they must be signed against a host your browser can reach.
# Defaults to http://localhost:9000 (docker-compose.yml exposes MinIO on
# that port). Override this if you're running the stack on a remote
# server — e.g. S3_PUBLIC_ENDPOINT_URL=http://your-server-ip:9000.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=CHANGE-ME-generate-with-openssl-rand-base64-32
S3_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-base64-32
S3_BUCKET_NAME=employee-portal
# MinIO's ports (9000 API, 9001 console) are bound to 127.0.0.1 on the host
# by default — only nginx is meant to be reachable from outside this
# machine. Leave this unset for local dev. Set S3_HOST_BIND=0.0.0.0 only if
# you deliberately want MinIO reachable directly from other machines (e.g.
# browsers hitting a remote server where S3_PUBLIC_ENDPOINT_URL above points
# at that server's real address instead of localhost).
S3_HOST_BIND=127.0.0.1

FRONTEND_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=/api/v1

# Ask HR chatbot (Phase 13) — free-tier key from aistudio.google.com/apikey.
# Leave blank to keep the feature dark even for companies that enable it in
# Integrations; a company's toggle and the platform key are independent.
GEMINI_API_KEY=
